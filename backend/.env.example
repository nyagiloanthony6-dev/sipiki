# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/sipiki"

# --- Auth ---
# At least 32 random characters:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# --- Sensitive-field encryption (NIDA numbers) ---
# Exactly 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Back this up separately: if it is lost, encrypted NIDA numbers cannot be recovered.
FIELD_ENCRYPTION_KEY=

# --- URLs ---
FRONTEND_URL=http://localhost:3000
APP_URL=https://sipiki.co.tz

# --- Server ---
PORT=4000
# Number of proxies in front of the app (1 on Vercel/Render/nginx). Needed for correct rate limiting.
# TRUST_PROXY=1

# --- Document uploads (private directory, never served publicly) ---
# UPLOAD_DIR=/var/sipiki/private-uploads

# --- SMS (Beem Africa). Leave SMS_PROVIDER unset in development: messages print to the console instead.
# SMS_PROVIDER=beem
# BEEM_API_KEY=
# BEEM_SECRET_KEY=
# BEEM_SENDER_ID=SIPIKI
