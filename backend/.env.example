# ============================================================================
# Backend settings. Copy to .env for local development.
# On Railway, set these in the service's "Variables" tab instead (never commit a real .env).
# ============================================================================

# --- Database ---
# Railway: reference the Postgres service →  ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://user:password@localhost:5432/sipiki"

# --- Auth ---
# At least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# --- Sensitive-field encryption (NIDA numbers) ---
# Exactly 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a copy in a password manager: if it is lost, encrypted NIDA numbers cannot be recovered.
FIELD_ENCRYPTION_KEY=

# --- URLs ---
# The website's address(es), exactly as shown in the browser, no trailing slash.
# Several can be listed, separated by commas:  https://sipiki.vercel.app,https://sipiki.co.tz
FRONTEND_URL=http://localhost:3000
# Used inside SMS messages
APP_URL=https://sipiki.co.tz

# --- Server ---
# PORT is provided by Railway automatically (leave unset there).
PORT=4000
# Railway is detected automatically (one proxy hop). Set this only on other hosts.
# TRUST_PROXY=1

# --- Document uploads (private, never served publicly) ---
# Railway: attach a Volume mounted at /data — uploads then go to /data/uploads automatically.
# Elsewhere (or to override), set a folder path:
# UPLOAD_DIR=/var/sipiki/private-uploads

# --- SMS (Beem Africa) ---
# Leave SMS_PROVIDER unset in development: messages are printed to the console instead.
# SMS_PROVIDER=beem
# BEEM_API_KEY=
# BEEM_SECRET_KEY=
# BEEM_SENDER_ID=SIPIKI
