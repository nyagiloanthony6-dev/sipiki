// ============================================================================
// Prisma schema — mirrors database/schema.sql
// Run `npx prisma migrate dev` to apply, `npx prisma generate` to build client
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  vendor
  admin

  @@map("user_role")
}

enum VendorStatus {
  pending
  active
  suspended
  rejected

  @@map("vendor_status")
}

enum DocumentType {
  owner_id
  business_license
  tin_certificate

  @@map("document_type")
}

enum OrderStatus {
  pending
  paid
  processing
  shipped
  delivered
  cancelled
  refunded

  @@map("order_status")
}

enum PaymentStatus {
  requires_payment
  succeeded
  failed
  refunded
  partially_refunded

  @@map("payment_status")
}

enum PayoutStatus {
  pending
  in_transit
  paid
  failed

  @@map("payout_status")
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique @db.VarChar(255)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  fullName      String    @map("full_name") @db.VarChar(255)
  role          UserRole  @default(customer)
  emailVerified Boolean   @default(false) @map("email_verified")
  avatarUrl     String?   @map("avatar_url")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  vendors         Vendor[]              @relation("VendorUser")
  reviewedVendors Vendor[]              @relation("VendorReviewer")
  statusChanges   VendorStatusHistory[]
  cart            Cart?
  orders          Order[]
  reviews         Review[]

  @@map("users")
}

model Vendor {
  id                   String       @id @default(uuid()) @db.Uuid
  userId               String       @map("user_id") @db.Uuid
  storeName            String       @map("store_name") @db.VarChar(255)
  storeSlug            String       @unique @map("store_slug") @db.VarChar(255)
  storeDescription     String?      @map("store_description")
  status               VendorStatus @default(pending)
  stripeAccountId      String?      @unique @map("stripe_account_id") @db.VarChar(255)
  stripeOnboardingDone Boolean      @default(false) @map("stripe_onboarding_done")
  commissionRate       Decimal      @default(10.00) @map("commission_rate") @db.Decimal(5, 2)

  // ---- Onboarding (migration 002) ----
  applicationRef      String?   @unique @map("application_ref") @db.VarChar(20)
  businessType        String?   @map("business_type") @db.VarChar(40)
  region              String?   @db.VarChar(60)
  location            String?   @db.VarChar(255)
  categories          String[]  @default([])
  ownerPhone          String?   @map("owner_phone") @db.VarChar(15)
  tin                 String?   @unique @db.VarChar(11)
  nidaNumberEncrypted String?   @map("nida_number_encrypted")
  payoutProvider      String?   @map("payout_provider") @db.VarChar(20)
  payoutPhone         String?   @map("payout_phone") @db.VarChar(15)
  payoutAccountName   String?   @map("payout_account_name") @db.VarChar(255)
  rejectionReason     String?   @map("rejection_reason")
  suspensionReason    String?   @map("suspension_reason")
  reviewedBy          String?   @map("reviewed_by") @db.Uuid
  reviewedAt          DateTime? @map("reviewed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User                  @relation("VendorUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewer   User?                 @relation("VendorReviewer", fields: [reviewedBy], references: [id])
  products   Product[]
  orderItems OrderItem[]
  payouts    VendorPayout[]
  documents  VendorDocument[]
  history    VendorStatusHistory[]
  smsLogs    SmsLog[]

  @@map("vendors")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  name      String   @db.VarChar(150)
  slug      String   @unique @db.VarChar(150)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")
  products Product[]

  @@map("categories")
}

model BusinessCategory {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(80)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("business_categories")
}

model Product {
  id            String    @id @default(uuid()) @db.Uuid
  vendorId      String    @map("vendor_id") @db.Uuid
  categoryId    String?   @map("category_id") @db.Uuid
  title         String    @db.VarChar(255)
  slug          String    @unique @db.VarChar(255)
  description   String?
  priceCents    Int       @map("price_cents")
  currency      String    @default("TZS") @db.Char(3)
  stockQuantity Int       @default(0) @map("stock_quantity")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  vendor     Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category   Category?      @relation(fields: [categoryId], references: [id])
  images     ProductImage[]
  tags       ProductTag[]
  reviews    Review[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@map("products")
}

model ProductImage {
  id         String  @id @default(uuid()) @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  url        String
  position   Int     @default(0) @db.SmallInt
  storageKey String? @unique @map("storage_key") @db.VarChar(48)
  mimeType   String? @map("mime_type") @db.VarChar(20)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model Tag {
  id       String       @id @default(uuid()) @db.Uuid
  name     String       @unique @db.VarChar(100)
  products ProductTag[]

  @@map("tags")
}

model ProductTag {
  productId String @map("product_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@map("product_tags")
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  rating    Int      @db.SmallInt
  comment   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@map("reviews")
}

model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  id               String      @id @default(uuid()) @db.Uuid
  userId           String?     @map("user_id") @db.Uuid
  orderRef         String?     @unique @map("order_ref") @db.VarChar(20)
  customerName     String?     @map("customer_name") @db.VarChar(100)
  customerPhone    String?     @map("customer_phone") @db.VarChar(15)
  paymentMethod    String      @default("on_delivery") @map("payment_method") @db.VarChar(20)
  status           OrderStatus @default(pending)
  subtotalCents    Int         @map("subtotal_cents")
  platformFeeCents Int         @default(0) @map("platform_fee_cents")
  totalCents       Int         @map("total_cents")
  currency         String      @default("TZS") @db.Char(3)
  shippingAddress  Json        @map("shipping_address")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User?          @relation(fields: [userId], references: [id])
  items        OrderItem[]
  transactions Transaction[]
  payouts      VendorPayout[]

  @@map("orders")
}

model OrderItem {
  id                String      @id @default(uuid()) @db.Uuid
  orderId           String      @map("order_id") @db.Uuid
  productId         String      @map("product_id") @db.Uuid
  vendorId          String      @map("vendor_id") @db.Uuid
  productTitle      String?     @map("product_title") @db.VarChar(255)
  quantity          Int
  unitPriceCents    Int         @map("unit_price_cents")
  subtotalCents     Int         @map("subtotal_cents")
  fulfillmentStatus OrderStatus @default(pending) @map("fulfillment_status")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  vendor  Vendor  @relation(fields: [vendorId], references: [id])

  @@map("order_items")
}

model Transaction {
  id                    String        @id @default(uuid()) @db.Uuid
  orderId               String        @map("order_id") @db.Uuid
  stripePaymentIntentId String        @unique @map("stripe_payment_intent_id") @db.VarChar(255)
  amountCents           Int           @map("amount_cents")
  currency              String        @default("USD") @db.Char(3)
  status                PaymentStatus @default(requires_payment)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  order   Order          @relation(fields: [orderId], references: [id])
  payouts VendorPayout[]

  @@map("transactions")
}

model VendorPayout {
  id               String       @id @default(uuid()) @db.Uuid
  vendorId         String       @map("vendor_id") @db.Uuid
  orderId          String       @map("order_id") @db.Uuid
  transactionId    String       @map("transaction_id") @db.Uuid
  grossAmountCents Int          @map("gross_amount_cents")
  platformFeeCents Int          @map("platform_fee_cents")
  netAmountCents   Int          @map("net_amount_cents")
  stripeTransferId String?      @unique @map("stripe_transfer_id") @db.VarChar(255)
  status           PayoutStatus @default(pending)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  vendor      Vendor      @relation(fields: [vendorId], references: [id])
  order       Order       @relation(fields: [orderId], references: [id])
  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@map("vendor_payouts")
}

model VendorDocument {
  id           String       @id @default(uuid()) @db.Uuid
  vendorId     String       @map("vendor_id") @db.Uuid
  type         DocumentType
  originalName String       @map("original_name") @db.VarChar(255)
  storageKey   String       @map("storage_key") @db.VarChar(255)
  mimeType     String       @map("mime_type") @db.VarChar(100)
  sizeBytes    Int          @map("size_bytes")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, type])
  @@map("vendor_documents")
}

model VendorStatusHistory {
  id         String        @id @default(uuid()) @db.Uuid
  vendorId   String        @map("vendor_id") @db.Uuid
  fromStatus VendorStatus? @map("from_status")
  toStatus   VendorStatus  @map("to_status")
  reason     String?
  changedBy  String?       @map("changed_by") @db.Uuid
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  admin  User?  @relation(fields: [changedBy], references: [id])

  @@index([vendorId, createdAt])
  @@map("vendor_status_history")
}

model SmsLog {
  id               String   @id @default(uuid()) @db.Uuid
  vendorId         String?  @map("vendor_id") @db.Uuid
  toPhone          String   @map("to_phone") @db.VarChar(15)
  template         String   @db.VarChar(40)
  message          String
  provider         String   @db.VarChar(20)
  success          Boolean
  providerResponse String?  @map("provider_response")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  vendor Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@map("sms_logs")
}
